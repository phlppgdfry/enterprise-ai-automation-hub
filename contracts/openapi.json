{
  "openapi": "3.0.3",
  "info": {
    "title": "Noordwerk Automation Hub — LOCAL DEMO",
    "version": "1.0.0",
    "description": "Loopback-only demo. Replace authentication and server before a cloud connector deployment."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5088"
    }
  ],
  "security": [
    {
      "demoBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health",
        "security": [],
        "responses": {
          "200": {
            "description": "Local simulator health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/requests": {
      "get": {
        "operationId": "ListRequests",
        "responses": {
          "200": {
            "description": "Visible requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Request"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failure"
          },
          "401": {
            "description": "Missing/invalid demo identity"
          },
          "403": {
            "description": "Forbidden role"
          },
          "404": {
            "description": "Missing/inaccessible request"
          },
          "409": {
            "description": "Conflicting key, version or state"
          }
        }
      },
      "post": {
        "operationId": "CreateRequest",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created or existing idempotent request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure"
          },
          "401": {
            "description": "Missing/invalid demo identity"
          },
          "403": {
            "description": "Forbidden role"
          },
          "404": {
            "description": "Missing/inaccessible request"
          },
          "409": {
            "description": "Conflicting key, version or state"
          }
        }
      }
    },
    "/requests/{id}": {
      "get": {
        "operationId": "GetRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Visible request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure"
          },
          "401": {
            "description": "Missing/invalid demo identity"
          },
          "403": {
            "description": "Forbidden role"
          },
          "404": {
            "description": "Missing/inaccessible request"
          },
          "409": {
            "description": "Conflicting key, version or state"
          }
        }
      }
    },
    "/requests/{id}/decision": {
      "post": {
        "operationId": "DecideRequest",
        "description": "Human approver only. Never expose as an agent tool.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure"
          },
          "401": {
            "description": "Missing/invalid demo identity"
          },
          "403": {
            "description": "Forbidden role"
          },
          "404": {
            "description": "Missing/inaccessible request"
          },
          "409": {
            "description": "Conflicting key, version or state"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "demoBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Known demo fixtures, NOT Entra tokens"
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "owner": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "materials",
              "expense",
              "access"
            ]
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "queue": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "actor": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "NewRequest": {
        "type": "object",
        "required": [
          "title",
          "category",
          "amount"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "category": {
            "type": "string",
            "enum": [
              "materials",
              "expense",
              "access"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000,
            "multipleOf": 0.01
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "outcome",
          "reason",
          "version"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
