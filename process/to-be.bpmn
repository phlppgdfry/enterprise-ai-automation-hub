      <bpmndi:BPMNShape id="yesShape" bpmnElement="yes">
        <dc:Bounds x="1280" y="225" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="noShape" bpmnElement="no">
        <dc:Bounds x="1280" y="310" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
